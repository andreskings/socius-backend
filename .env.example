DATABASE_URL="postgresql://socius:socius@localhost:5432/socius?schema=public"
PORT=4000
JWT_SECRET="cambia-este-valor-por-uno-generado-aleatoriamente"
FRONTEND_ORIGIN="http://localhost:3000"
ADMIN_SEED_EMAIL="admin@socius.local"
ADMIN_SEED_PASSWORD="Cambiar123!"
ADMIN_SEED_NOMBRE="Administrador"
GROQ_API_KEY="obtenela gratis en https://console.groq.com/keys"
GROQ_MODEL="llama-3.3-70b-versatile"

# Envío de correos (verificación de cuenta / restablecer contraseña) vía la API
# de Brevo (https://www.brevo.com, gratis hasta 300 correos/día). Se usa la API
# HTTP en vez de SMTP porque Gmail bloquea el envío SMTP programático en cuentas
# nuevas/no reconocidas. Conseguí la key en Brevo > Configuración > SMTP y API >
# pestaña "API Keys" (empieza con "xkeysib-"). MAIL_FROM tiene que ser un correo
# verificado como remitente en Brevo (Configuración > Remitentes).
BREVO_API_KEY="xkeysib-..."
MAIL_FROM="tu-correo-verificado@gmail.com"
